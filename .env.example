# Copy to .env and fill in. .env is gitignored; never commit real values.

# Tatum API key from https://dashboard.tatum.io (keyless gateway access is limited to 5 requests/minute)
TATUM_API_KEY=

# Walrus Memory credentials from https://memory.walrus.xyz (Mainnet).
# Create a delegate key dedicated to this app.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Sui network for payments: devnet, testnet or mainnet
SUI_NETWORK=devnet

# Generated by `npm run setup:wallets`.
# SERVER_SUI_ADDRESS receives the demo provider's payments. The web app holds no private key:
# every payment is signed by the visitor's own wallet. AGENT_SUI_PRIVATE_KEY is only for the
# command-line agent (`npm run agent`), never for the web app.
AGENT_SUI_PRIVATE_KEY=
SERVER_SUI_PRIVATE_KEY=
SERVER_SUI_ADDRESS=

# Web app (npm start)
# Public address people open. https enables Secure cookies and requires SESSION_SECRET.
PUBLIC_ORIGIN=http://localhost:4030
# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Signs the demo provider's payment challenges, so quotes survive a restart.
SERVER_CHALLENGE_SECRET=
PORT=4030
# 0.0.0.0 when running in a container behind a proxy
HOST=127.0.0.1
# 1 when behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Where per-wallet limits and activity are kept, and the provider's used-payment ledger
DATA_DIR=data
LEDGER_PATH=data/used-digests.txt
# 1 only for local development against providers on your own machine
ALLOW_PRIVATE_PROVIDERS=0
