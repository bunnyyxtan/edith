# Copy to .env and fill in. .env is gitignored; never commit real values.

# Tatum API key from https://dashboard.tatum.io (keyless gateway access is limited to 5 requests/minute)
TATUM_API_KEY=

# Walrus Memory credentials from https://memory.walrus.xyz (Mainnet).
# Create a delegate key dedicated to this app.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Sui network for payments: devnet, testnet or mainnet
SUI_NETWORK=devnet

# Generated by `npm run setup:wallets`
AGENT_SUI_PRIVATE_KEY=
SERVER_SUI_PRIVATE_KEY=
SERVER_SUI_ADDRESS=
