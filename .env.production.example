# Production settings for the Docker image. Set these as the host's environment variables (or copy to
# .env.production and pass with --env-file). Never commit the filled-in file.

# The public https address, exactly as people open it.
PUBLIC_ORIGIN=https://your-domain.example

# Long random values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SERVER_CHALLENGE_SECRET=

# Integrations
TATUM_API_KEY=
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
SUI_NETWORK=mainnet

# Receives Quote Desk demo payments (address only; no private key needed on the server)
SERVER_SUI_ADDRESS=

# Durable state (Neon Postgres). On Vercel the Neon integration sets this for you.
DATABASE_URL=

# Vercel only: let Edith read request bodies itself
NODEJS_HELPERS=0

# Already set by the image; change only if your host needs different values
# DATA_DIR=/data
# PORT=4030
# HOST=0.0.0.0
# TRUST_PROXY=1
